[resource]
script = ExtResource("1_phld4")
character_name = "Хлопчик"
text = "Кстати, раз уж ты здесь. Сгоняй кобанчиком до моего друга, передай ему Книгу. Он если что сидит за Красной дверью, а я тебе скажу где от нее ключ. Может что-то интересное там найдешь"
