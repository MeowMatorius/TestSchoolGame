[physics]

common/physics_interpolation=true

[rendering]

textures/streaming/enabled=true
rendering_device/driver.windows="d3d12"
lights_and_shadows/contact_shadow/enabled=true
lights_and_shadows/multi_bounce_occlusion/enabled=true
textures/default_filters/anisotropic_filtering_level=4
viewport/hdr_2d=true
anti_aliasing/quality/screen_space_aa=2
anti_aliasing/quality/use_taa=true
occlusion_culling/use_occlusion_culling=true

[shader_globals]

psx_affine_strength={
"type": "float",
"value": 1.0
}
psx_bit_depth={
"type": "uint",
"value": 5
}
psx_fog_color={
"type": "color",
"value": Color(0.5, 0.5, 0.5, 0)
}
psx_fog_far={
"type": "float",
"value": 20.0
}
psx_fog_near={
"type": "float",
"value": 10.0
}
psx_precision_uv={
"type": "float",
"value": 128.0
}
psx_precision_xy={
"type": "float",
"value": 256.0
}
psx_precision_z={
"type": "float",
"value": 512.0
}
